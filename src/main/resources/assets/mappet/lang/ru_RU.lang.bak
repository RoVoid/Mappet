# Commands
mappet.commands.mp.help=Р“Р»Р°РІРЅР°СЏ РєРѕРјР°РЅРґР° РњР°РїРїРµС‚Р°, РїСЂРµРґРѕСЃС‚Р°РІР»СЏСЋС‰Р°СЏ РїРѕРґРєРѕРјР°РЅРґС‹ РґР»СЏ СЂР°Р±РѕС‚С‹ СЃ РІРѕР·РјРѕР¶РЅРѕСЃС‚СЏРјРё РњР°РїРїРµС‚Р°.

mappet.commands.mp.state.help=РџРѕРґРєРѕРјР°РЅРґР° СѓРїСЂР°РІР»РµРЅРёСЏ СЃРѕСЃС‚РѕСЏРЅРёСЏРјРё.\n\n РђСЂРіСѓРјРµРЅС‚ С†РµР»Рё В§7<target>В§r РёСЃРїРѕР»СЊР·СѓРµС‚СЃСЏ С‡С‚РѕР±С‹ РѕРїСЂРµРґРµР»РёС‚СЊ, С‡СЊС‘ СЃРѕСЃС‚РѕСЏРЅРёРµ РёР·РјРµРЅСЏС‚СЊ. Р’С‹ РјРѕР¶РµС‚Рµ СѓРєР°Р·Р°С‚СЊ РєР°Рє РЅРёРє РёРіСЂРѕРєР° С‡С‚РѕР±С‹ РёР·РјРµРЅРёС‚СЊ РµРіРѕ СЃРѕСЃС‚РѕСЏРЅРёРµ, С‚Р°Рє Рё В§7~В§r РґР»СЏ РёР·РјРµРЅРµРЅРёСЏ РіР»РѕР±Р°Р»СЊРЅРѕРіРѕ СЃРѕСЃС‚РѕСЏРЅРёСЏ.
mappet.commands.mp.state.add=Р­С‚Р° РєРѕРјР°РЅРґР° РґРѕР±Р°РІР»СЏРµС‚ В§7<value>В§r Рє СЃРѕСЃС‚РѕСЏРЅРёСЋ В§7<id>В§r. Р•СЃР»Рё СЃРѕСЃС‚РѕСЏРЅРёРµ В§7<id>В§r РЅРµ СЃСѓС‰РµСЃС‚РІСѓРµС‚ РёР»Рё СЏРІР»СЏРµС‚СЃСЏ С‚РµРєСЃС‚РѕРј, В§7<value>В§r Р±СѓРґРµС‚ РґРѕР±Р°РІР»РµРЅРѕ Рє РЅСѓР»СЋ.
mappet.commands.mp.state.clear=Р­С‚Р° РєРѕРјР°РЅРґР° РѕС‡РёС‰Р°РµС‚ СЃРѕСЃС‚РѕСЏРЅРёРµ В§7[id]В§r. Р•СЃР»Рё В§7[id]В§r РЅРµ СѓРєР°Р·Р°РЅ, С‚Рѕ Р±СѓРґСѓС‚ РѕС‡РёС‰РµРЅС‹ РІСЃРµ СЃРѕСЃС‚РѕСЏРЅРёСЏ. Р’С‹ РјРѕР¶РµС‚Рµ РёСЃРїРѕР»СЊР·РѕРІР°С‚СЊ В§7*В§r РєР°Рє С€Р°Р±Р»РѕРЅ РІ В§7[id]В§r С‡С‚РѕР±С‹ РѕС‡РёС‰Р°С‚СЊ РЅРµСЃРєРѕР»СЊРєРѕ СЃРѕСЃС‚РѕСЏРЅРёР№ СЃСЂР°Р·Сѓ.
mappet.commands.mp.state.if=Р­С‚Р° РєРѕРјР°РЅРґР° РІС‹С‡РёСЃР»СЏРµС‚ В§7<expression>В§r РїРѕ Р·РЅР°С‡РµРЅРёСЋ СЃРѕСЃС‚РѕСЏРЅРёСЏ В§7<id>В§r, Рё РµСЃР»Рё СЂРµР·СѓР»СЊС‚Р°С‚ В§7<expression>В§r РЅРµ СЂР°РІРµРЅ РЅСѓР»СЋ, С‚Рѕ РЅРёС‡РµРіРѕ РЅРµ РїСЂРѕРёСЃС…РѕРґРёС‚, РЅРѕ РµСЃР»Рё СЂРµР·СѓР»СЊС‚Р°С‚ СЂР°РІРµРЅ РЅСѓР»СЋ С‚РѕРіРґР° РєРѕРјР°РЅРґР° РІС‹РґР°СЃС‚ РѕС€РёР±РєСѓ.\n\nР­С‚Рѕ РїРѕР»РµР·РЅРѕ РґР»СЏ РєРѕРјР°РЅРґРЅС‹С… Р±Р»РѕРєРѕРІ, РєРѕС‚РѕСЂС‹Рµ РѕСЃС‚Р°РЅР°РІР»РёРІР°СЋС‚СЃСЏ РїСЂРё РїРѕСЏРІР»РµРЅРёРё РѕС€РёР±РєРё.
mappet.commands.mp.state.print=Р­С‚Р° РєРѕРјР°РЅРґР° РІС‹РІРѕРґРёС‚ РІ С‡Р°С‚ РІСЃРµ Р·РЅР°С‡РµРЅРёСЏ СЃРѕСЃС‚РѕСЏРЅРёР№, РєРѕС‚РѕСЂС‹Рµ РёРјРµСЋС‚СЃСЏ Сѓ В§7<target>В§r.
mappet.commands.mp.state.set=Р­С‚Р° РєРѕРјР°РЅРґР° СѓСЃС‚Р°РЅР°РІР»РёРІР°РµС‚ В§7<value>В§r (РјРѕР¶РµС‚ Р±С‹С‚СЊ С‡РёСЃР»РѕРј РёР»Рё РїСЂРѕРёР·РІРѕР»СЊРЅС‹Рј С‚РµРєСЃС‚РѕРј) РґР»СЏ СЃРѕСЃС‚РѕСЏРЅРёСЏ В§7<id>В§r.
mappet.commands.mp.state.sub=Р­С‚Р° РєРѕРјР°РЅРґР° РІС‹С‡РёС‚Р°РµС‚ В§7<value>В§r РёР· СЃРѕСЃС‚РѕСЏРЅРёСЏ В§7<id>В§r. Р•СЃР»Рё СЃРѕСЃС‚РѕСЏРЅРёРµ В§7<id>В§r РЅРµ СЃСѓС‰РµСЃС‚РІСѓРµС‚ РёР»Рё СЏРІР»СЏРµС‚СЃСЏ С‚РµРєСЃС‚РѕРј, В§7<value>В§r Р±СѓРґРµС‚ РІС‹С‡С‚РµРЅРѕ РёР· РЅСѓР»СЏ.

mappet.commands.mp.quest.help=РџРѕРґРєРѕРјР°РЅРґР° СѓРїСЂР°РІР»РµРЅРёСЏ РєРІРµСЃС‚Р°РјРё.
mappet.commands.mp.quest.accept=Р­С‚Р° РєРѕРјР°РЅРґР° РґР°С‘С‚ РєРІРµСЃС‚ В§7<id>В§r РёР· Р±Р°Р·С‹ РґР°РЅРЅС‹С… РєРІРµСЃС‚РѕРІ РёРіСЂРѕРєСѓ/Р°Рј В§7<player>В§r. Р•СЃР»Рё РёРіСЂРѕРє/Рё В§7<player>В§r СѓР¶Рµ РёРјРµСЋС‚ СЌС‚РѕС‚ РєРІРµСЃС‚, СЃРѕР±С‹С‚РёРµ Р±СѓРґРµС‚ РїСЂРѕРёРіРЅРѕСЂРёСЂРѕРІР°РЅРѕ.
mappet.commands.mp.quest.complete=Р­С‚Р° РєРѕРјР°РЅРґР° Р·Р°РІРµСЂС€Р°РµС‚ РєРІРµСЃС‚ (РІРЅРµ Р·Р°РІРёСЃРёРјРѕСЃС‚Рё РѕС‚ С‚РѕРіРѕ РґРѕСЃС‚РёРі Р»Рё РёРіСЂРѕРє РїРѕСЃС‚Р°РІР»РµРЅРЅС‹С… Р·Р°РґР°С‡) В§7<id>В§r РґР»СЏ РёРіСЂРѕРєР°/РѕРІ В§7<player>В§r.
mappet.commands.mp.quest.decline=Р­С‚Р° РєРѕРјР°РЅРґР° СѓРґР°Р»СЏРµС‚ РєРІРµСЃС‚ В§7<id>В§r Сѓ РґР»СЏ РёРіСЂРѕРєР°/РѕРІ В§7<player>В§r.

