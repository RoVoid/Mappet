{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"required": ["version", "generated", "root", "packages", "classes"],
	"properties": {
		"version": {
			"type": "integer",
			"minimum": 1
		},
		"generated": {
			"type": "string",
			"format": "date"
		},
		"root": {
			"type": "string"
		},
		"packages": {
			"type": "array",
			"items": { "type": "string" }
		},
		"classes": {
			"type": "object",
			"additionalProperties": {
				"type": "object",
				"required": ["name", "deprecated", "methods"],
				"properties": {
					"name": { "type": "string" },
					"deprecated": { "type": "boolean" },
					"methods": {
						"type": "array",
						"items": { "type": "string" }
					}
				}
			}
		}
	}
}